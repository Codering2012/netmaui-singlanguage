<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SignLanguageApp.Controls.AnimatedBackgroundView">

    <Grid x:Name="BackgroundGrid"
          RowDefinitions="*"
          ColumnDefinitions="*"
          IsClippedToBounds="True">

        <!-- Base transparent layer so page gradient shows through -->
        <BoxView Grid.Row="0"
                 Grid.Column="0"
                 BackgroundColor="Transparent"
                 x:Name="BaseLayer" />

        <!-- Animated gradient blob 1 (Violet / Purple) -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              x:Name="Blob1Container"
              WidthRequest="650"
              HeightRequest="650"
              HorizontalOptions="Start"
              VerticalOptions="Start">
            <Ellipse WidthRequest="650"
                     HeightRequest="650"
                     x:Name="Blob1"
                     Opacity="{DynamicResource AmbientBlobOpacity}">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5">
                        <GradientStop Color="#808B5CF6" Offset="0.0" />
                        <GradientStop Color="#408B5CF6" Offset="0.5" />
                        <GradientStop Color="#008B5CF6" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Animated gradient blob 2 (Electric Cyan) -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              x:Name="Blob2Container"
              WidthRequest="700"
              HeightRequest="700"
              HorizontalOptions="End"
              VerticalOptions="Start">
            <Ellipse WidthRequest="700"
                     HeightRequest="700"
                     x:Name="Blob2"
                     Opacity="{DynamicResource AmbientBlobOpacity}">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5">
                        <GradientStop Color="#8006B6D4" Offset="0.0" />
                        <GradientStop Color="#4006B6D4" Offset="0.5" />
                        <GradientStop Color="#0006B6D4" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Animated gradient blob 3 (Vibrant Pink / Rose) -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              x:Name="Blob3Container"
              WidthRequest="750"
              HeightRequest="650"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Ellipse WidthRequest="750"
                     HeightRequest="650"
                     x:Name="Blob3"
                     Opacity="{DynamicResource AmbientBlobOpacity}">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5">
                        <GradientStop Color="#80EC4899" Offset="0.0" />
                        <GradientStop Color="#40EC4899" Offset="0.5" />
                        <GradientStop Color="#00EC4899" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Animated gradient blob 4 (Royal Blue) -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              x:Name="Blob4Container"
              WidthRequest="680"
              HeightRequest="680"
              HorizontalOptions="End"
              VerticalOptions="End">
            <Ellipse WidthRequest="680"
                     HeightRequest="680"
                     x:Name="Blob4"
                     Opacity="{DynamicResource AmbientBlobOpacity}">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5">
                        <GradientStop Color="#803B82F6" Offset="0.0" />
                        <GradientStop Color="#403B82F6" Offset="0.5" />
                        <GradientStop Color="#003B82F6" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Animated gradient blob 5 (Indigo) -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              x:Name="Blob5Container"
              WidthRequest="620"
              HeightRequest="620"
              HorizontalOptions="Start"
              VerticalOptions="End">
            <Ellipse WidthRequest="620"
                     HeightRequest="620"
                     x:Name="Blob5"
                     Opacity="{DynamicResource AmbientBlobOpacity}">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5">
                        <GradientStop Color="#806366F1" Offset="0.0" />
                        <GradientStop Color="#406366F1" Offset="0.5" />
                        <GradientStop Color="#006366F1" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

    </Grid>

</ContentView>
