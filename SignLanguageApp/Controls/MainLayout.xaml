<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SignLanguageApp.Controls"
             x:Class="SignLanguageApp.Controls.MainLayout">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Grid x:Name="RootGrid" Background="{DynamicResource PageGradient}">
                <!-- Ambient Animated Glowing Orbs Background -->
                <controls:AnimatedBackgroundView InputTransparent="True" />

                <ContentPresenter />
                
                <!-- The custom liquid navigation bar -->
                <controls:LiquidNavigationBar />
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
