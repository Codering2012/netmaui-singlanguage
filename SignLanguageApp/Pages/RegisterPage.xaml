<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SignLanguageApp.ViewModels"
             xmlns:controls="clr-namespace:SignLanguageApp.Controls"
             x:Class="SignLanguageApp.Pages.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Register"
             BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid Background="{DynamicResource PageGradient}">
        <Grid x:Name="MainGrid" ColumnDefinitions="450, *">
            <!-- Left Column -->
            <Grid x:Name="LeftColumn" Grid.Column="0" BackgroundColor="Transparent">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Margin="30" Spacing="30" VerticalOptions="Center" MinimumHeightRequest="550">
                        
                        <!-- Top Header -->
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                            <Label Text="SignLanguageApp" TextColor="{DynamicResource PrimaryColor}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        
                        <!-- Center Card -->
                        <Border BackgroundColor="{DynamicResource CardBackgroundColor}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="30" VerticalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="{DynamicResource GlassShadowOpacity}"/>
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="20">
                                
                                <VerticalStackLayout Spacing="5" Margin="0,-10,0,10">
                                    <Label Text="Join us," TextColor="{DynamicResource SecondaryTextColor}" HorizontalOptions="Center" FontSize="14" />
                                    <Label Text="Create Account" TextColor="{DynamicResource PrimaryTextColor}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                
                                <Label Text="Start your learning journey today" TextColor="{DynamicResource PrimaryColor}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,-10,0,10" />
                                
                                <!-- Username Input -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Username" TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" FontAttributes="Bold" />
                                    <Border Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" HeightRequest="50" Padding="15,0">
                                        <Entry Text="{Binding Name}" Placeholder="Choose a username" TextColor="{DynamicResource PrimaryTextColor}" PlaceholderColor="{DynamicResource InputPlaceholderColor}" VerticalOptions="Center" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" />
                                    </Border>
                                </VerticalStackLayout>
                                
                                <!-- Email Input -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Email Address" TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" FontAttributes="Bold" />
                                    <Border Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" HeightRequest="50" Padding="15,0">
                                        <Entry Text="{Binding Email}" Placeholder="name@example.com" Keyboard="Email" TextColor="{DynamicResource PrimaryTextColor}" PlaceholderColor="{DynamicResource InputPlaceholderColor}" VerticalOptions="Center" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" />
                                    </Border>
                                </VerticalStackLayout>
                                
                                <!-- Password Input -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Password" TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" FontAttributes="Bold" />
                                    <Border Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" HeightRequest="50" Padding="15,0">
                                        <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Create a password" TextColor="{DynamicResource PrimaryTextColor}" PlaceholderColor="{DynamicResource InputPlaceholderColor}" VerticalOptions="Center" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" />
                                    </Border>
                                </VerticalStackLayout>
                                
                                <!-- Confirm Password Input -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Confirm Password" TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" FontAttributes="Bold" />
                                    <Border Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" HeightRequest="50" Padding="15,0">
                                        <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Repeat password" TextColor="{DynamicResource PrimaryTextColor}" PlaceholderColor="{DynamicResource InputPlaceholderColor}" VerticalOptions="Center" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" />
                                    </Border>
                                </VerticalStackLayout>
                                
                                <!-- Error Message -->
                                <Label Text="{Binding ErrorMessage}"
                                       TextColor="{DynamicResource ErrorColor}"
                                       FontSize="13"
                                       IsVisible="{Binding HasError}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                                       
                                <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}" HorizontalOptions="Center" Color="{DynamicResource PrimaryColor}" HeightRequest="24" WidthRequest="24" />
                                
                                <!-- Register Button -->
                                <Button Text="REGISTER"
                                        Command="{Binding RegisterCommand}"
                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                        TextColor="{DynamicResource ButtonTextColor}"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        CornerRadius="12"
                                        HeightRequest="50"
                                        Margin="0,10,0,0" />
                            </VerticalStackLayout>
                        </Border>
                        
                        <!-- Login Prompt -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="Already have an account?" TextColor="{DynamicResource SecondaryTextColor}" FontSize="14" />
                            <Label Text="Login Here" TextColor="{DynamicResource PrimaryColor}" FontSize="14" FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LoginCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- Right Column (Branding) -->
            <Grid x:Name="RightColumn" Grid.Column="1" BackgroundColor="Transparent" Padding="60">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                    <Label Text="SignLanguageApp" TextColor="{DynamicResource PrimaryColor}" FontSize="64" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                    <Label Text="Bridging gaps with every sign" TextColor="{DynamicResource SecondaryTextColor}" FontSize="24" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                
                <Label Text="Over 10,000 students learning ASL with us." TextColor="{DynamicResource SecondaryTextColor}" FontSize="14" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,30" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
