<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SignLanguageApp.ViewModels"
             xmlns:controls="clr-namespace:SignLanguageApp.Controls"
             x:Class="SignLanguageApp.Pages.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home"
             BackgroundColor="Transparent">

    <controls:MainLayout>
        <ScrollView Padding="0,0,0,100">
            <VerticalStackLayout Spacing="24" Padding="20,20,20,120">

                <Border StrokeThickness="1" Stroke="{DynamicResource BorderBrush}" BackgroundColor="{DynamicResource CardBackgroundColor}" StrokeShape="RoundRectangle 24" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,6" Radius="15" Opacity="{DynamicResource GlassShadowOpacity}"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding GreetingMessage, StringFormat='{0} 👋'}" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                        <Label Text="Practice a little every day to keep momentum 🔥" FontSize="14" TextColor="{DynamicResource SecondaryTextColor}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15" Margin="0,10,0,0">
                            <Border Grid.Column="0" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Streak 📅" FontSize="12" TextColor="{DynamicResource SecondaryTextColor}" />
                                    <Label Text="{Binding LearningStreak, StringFormat='{0} days'}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,10">
                                <Label Text="Consistency beats intensity 💪" VerticalOptions="Center" TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" />
                            </Border>
                            <Button Grid.Column="2"
                                    Text="Camera 📷"
                                    Command="{Binding OpenCameraCommand}"
                                    BackgroundColor="{DynamicResource SecondaryColor}"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Padding="16,10"
                                    CornerRadius="14" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="1" Stroke="{DynamicResource BorderBrush}" BackgroundColor="{DynamicResource CardBackgroundColor}" StrokeShape="RoundRectangle 24" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,6" Radius="15" Opacity="{DynamicResource GlassShadowOpacity}"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Sign of the day 🌟" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                        <Label Text="{Binding SignOfTheDay.SignName, StringFormat='Focus: {0} ✋', TargetNullValue='Focus: Hello ✋'}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource PrimaryColor}" />
                        <Label Text="{Binding SignOfTheDay.Description, TargetNullValue='Learn one practical sign today and use it in context 🧠'}"
                               FontSize="14"
                               TextColor="{DynamicResource SecondaryTextColor}"
                               LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15" Margin="0,5,0,0">
                            <Label Grid.Column="0"
                                   Text="Tap to mark this lesson as reviewed ✅"
                                   FontSize="12"
                                   TextColor="{DynamicResource SecondaryTextColor}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Practice 🎯"
                                    Command="{Binding ToggleSignOfTheDayCommand}"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource ButtonTextColor}"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    CornerRadius="14"
                                    Padding="20,10" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Recommended lessons 📚" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecommendedLessons}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LessonItem">
                                <Border StrokeThickness="1" Stroke="{DynamicResource BorderBrush}" BackgroundColor="{DynamicResource CardBackgroundColor}" StrokeShape="RoundRectangle 20" Padding="15">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="{DynamicResource GlassShadowOpacity}"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="15">
                                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" StrokeShape="RoundRectangle 15" HeightRequest="80" WidthRequest="90">
                                            <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                                            <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{DynamicResource SecondaryTextColor}" MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                                                <Label Grid.Column="0" Text="{Binding Difficulty}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SecondaryColor}" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="|" FontSize="12" TextColor="{DynamicResource SecondaryTextColor}" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="{Binding ViewCount, StringFormat='{0:N0} views 👀'}" FontSize="12" TextColor="{DynamicResource SecondaryTextColor}" VerticalOptions="Center" />
                                                
                                                <Button Grid.Column="3" Text="Open 🚀"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToLessonCommand}"
                                                        CommandParameter="{Binding .}"
                                                        HorizontalOptions="End"
                                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                                        TextColor="{DynamicResource ButtonTextColor}"
                                                        FontAttributes="Bold"
                                                        CornerRadius="10"
                                                        FontSize="12"
                                                        Padding="12,6" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Source Creators 🎬" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SourceCreators}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommunityItem">
                                <Border StrokeThickness="1" Stroke="{DynamicResource BorderBrush}" BackgroundColor="{DynamicResource CardBackgroundColor}" StrokeShape="RoundRectangle 16" Padding="12">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="{DynamicResource GlassShadowOpacity}"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="15">
                                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" StrokeShape="RoundRectangle 12" HeightRequest="60" WidthRequest="60">
                                            <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                                            <Label Text="{Binding Contributor}" FontSize="13" TextColor="{DynamicResource SecondaryTextColor}" MaxLines="3" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </controls:MainLayout>
</ContentPage>
