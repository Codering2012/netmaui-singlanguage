<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SignLanguageApp.ViewModels"
             xmlns:controls="clr-namespace:SignLanguageApp.Controls"
             x:Class="SignLanguageApp.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login"
             BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid Background="{DynamicResource PageGradient}">
        <!-- Ambient Animated Glowing Background Orbs -->
        <controls:AnimatedBackgroundView InputTransparent="True" />

        <Grid x:Name="MainGrid" ColumnDefinitions="450, *">
            <!-- Left Column: Login Card -->
            <Grid x:Name="LeftColumn" Grid.Column="0" BackgroundColor="Transparent">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Margin="36,24" Spacing="24" VerticalOptions="Center">
                        
                        <!-- Top App Brand Header & Theme Switcher -->
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource PrimaryGlassBackgroundColor}" Padding="8" WidthRequest="38" HeightRequest="38">
                                    <Path Data="M21.5 14.5c0-1.1-.9-2-2-2h-3v-5c0-1.1-.9-2-2-2s-2 .9-2 2v5h-1v-7c0-1.1-.9-2-2-2s-2 .9-2 2v7h-1v-5c0-1.1-.9-2-2-2s-2 .9-2 2v9.5c0 4.14 3.36 7.5 7.5 7.5s7.5-3.36 7.5-7.5v-3.5z" 
                                          Fill="{DynamicResource PrimaryColor}" 
                                          Aspect="Uniform" 
                                          WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="SignLanguageApp" TextColor="{DynamicResource PrimaryTextColor}" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="1" HorizontalOptions="End" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 20" BackgroundColor="{DynamicResource CardBackgroundColor}" Padding="14,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeToggleTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Path Data="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"
                                          Fill="{DynamicResource PrimaryColor}"
                                          Aspect="Uniform"
                                          WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                    <Label x:Name="ThemeToggleLabel" Text="Switch Theme" TextColor="{DynamicResource SecondaryTextColor}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        
                        <!-- Center Login Glass Card -->
                        <Border BackgroundColor="{DynamicResource CardBackgroundColor}" 
                                Stroke="{DynamicResource NavBarStrokeColor}" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 28" 
                                Padding="32" 
                                VerticalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,12" Radius="24" Opacity="{DynamicResource GlassShadowOpacity}"/>
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="20">
                                
                                <!-- Profile Avatar Badge -->
                                <Border Stroke="{DynamicResource PrimaryColor}" 
                                        StrokeThickness="2.5" 
                                        StrokeShape="RoundRectangle 45" 
                                        HeightRequest="86" 
                                        WidthRequest="86" 
                                        HorizontalOptions="Center" 
                                        BackgroundColor="{DynamicResource PrimaryGlassBackgroundColor}" 
                                        Margin="0,0,0,5">
                                    <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                                          Fill="{DynamicResource PrimaryColor}" 
                                          Aspect="Uniform" 
                                          WidthRequest="40" HeightRequest="40" 
                                          HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                
                                <VerticalStackLayout Spacing="4" Margin="0,-5,0,5">
                                    <Label Text="Welcome back," TextColor="{DynamicResource SecondaryTextColor}" HorizontalOptions="Center" FontSize="14" />
                                    <Label Text="Demo Learner" TextColor="{DynamicResource PrimaryTextColor}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                
                                <Label Text="Not you? Sign in with another account" TextColor="{DynamicResource PrimaryColor}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,-8,0,8" />
                                
                                <!-- Email Input -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Email Address" TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" FontAttributes="Bold" />
                                    <Border Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" HeightRequest="52" Padding="16,0">
                                        <Entry Text="{Binding Email}" Placeholder="name@example.com" TextColor="{DynamicResource PrimaryTextColor}" PlaceholderColor="{DynamicResource InputPlaceholderColor}" VerticalOptions="Center" FontSize="14" />
                                    </Border>
                                </VerticalStackLayout>
                                
                                <!-- Password Input -->
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Password" TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="End" />
                                        <Label Grid.Column="1" Text="Forgot password?" TextColor="{DynamicResource PrimaryColor}" FontSize="12" FontAttributes="Bold" VerticalOptions="End" />
                                    </Grid>
                                    <Border Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" HeightRequest="52" Padding="16,0">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" TextColor="{DynamicResource PrimaryTextColor}" PlaceholderColor="{DynamicResource InputPlaceholderColor}" VerticalOptions="Center" FontSize="14" />
                                            <Label Grid.Column="1" Text="SHOW" TextColor="{DynamicResource PrimaryColor}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                
                                <!-- Error Message -->
                                <Label Text="{Binding ErrorMessage}"
                                       TextColor="{DynamicResource ErrorColor}"
                                       FontSize="13"
                                       IsVisible="{Binding HasError}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                                       
                                <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}" HorizontalOptions="Center" Color="{DynamicResource PrimaryColor}" HeightRequest="24" WidthRequest="24" />
                                
                                <!-- Login Button -->
                                <Button Text="SIGN IN"
                                        Command="{Binding LoginCommand}"
                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                        TextColor="{DynamicResource ButtonTextColor}"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        CornerRadius="14"
                                        HeightRequest="52"
                                        Margin="0,8,0,0">
                                    <Button.Shadow>
                                        <Shadow Brush="{DynamicResource PrimaryColor}" Offset="0,6" Radius="12" Opacity="0.3" />
                                    </Button.Shadow>
                                </Button>
                            </VerticalStackLayout>
                        </Border>
                        
                        <!-- Bottom Register -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="New to SignLanguageApp?" TextColor="{DynamicResource SecondaryTextColor}" FontSize="14" />
                            <Label Text="Create Account" TextColor="{DynamicResource PrimaryColor}" FontSize="14" FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RegisterCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- Right Column (Branding & Mini Showcase Slideshow) -->
            <Grid x:Name="RightColumn" Grid.Column="1" BackgroundColor="Transparent" Padding="60">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="36" MaximumWidthRequest="520">
                    
                    <!-- Original Brand Header -->
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="SignLanguageApp" 
                               TextColor="{DynamicResource PrimaryColor}" 
                               FontSize="56" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center" 
                               MaxLines="1" 
                               LineBreakMode="TailTruncation" />

                        <Label Text="Bridging gaps with every sign" 
                               TextColor="{DynamicResource SecondaryTextColor}" 
                               FontSize="22" 
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center" 
                               MaxLines="1" 
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <!-- Mini Showcase Slideshow Card -->
                    <Border Stroke="{DynamicResource NavBarStrokeColor}" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 24" 
                            BackgroundColor="{DynamicResource CardBackgroundColor}" 
                            Padding="28,24" 
                            HorizontalOptions="Fill">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="{DynamicResource GlassShadowOpacity}" />
                        </Border.Shadow>
                        
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Slide Content Container -->
                            <Grid x:Name="SlideshowContainer" HeightRequest="120">
                                
                                <!-- Slide 1 -->
                                <Grid x:Name="Slide1" ColumnDefinitions="Auto, *" ColumnSpacing="18" VerticalOptions="Center">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="{DynamicResource PrimaryGlassBackgroundColor}" WidthRequest="54" HeightRequest="54" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z" Fill="{DynamicResource PrimaryColor}" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Border HorizontalOptions="Start" StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource PrimaryGlassBackgroundColor}" Padding="8,3" Margin="0,0,0,2">
                                            <Label Text="AI GESTURE RECOGNITION" TextColor="{DynamicResource PrimaryColor}" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <Label Text="Instant Camera Feedback" TextColor="{DynamicResource PrimaryTextColor}" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="Practice hand signs in real-time with instant AI accuracy scoring." TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Slide 2 -->
                                <Grid x:Name="Slide2" ColumnDefinitions="Auto, *" ColumnSpacing="18" VerticalOptions="Center" IsVisible="False" Opacity="0">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="{DynamicResource SuccessGlassBackgroundColor}" WidthRequest="54" HeightRequest="54" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" Fill="{DynamicResource SuccessGlassSolidColor}" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Border HorizontalOptions="Start" StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource SuccessGlassBackgroundColor}" Padding="8,3" Margin="0,0,0,2">
                                            <Label Text="GAMIFIED LESSONS" TextColor="{DynamicResource SuccessGlassSolidColor}" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <Label Text="Interactive Quizzes &amp; XP" TextColor="{DynamicResource PrimaryTextColor}" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="Build combo streaks, earn XP rewards, and level up your skills daily." TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Slide 3 -->
                                <Grid x:Name="Slide3" ColumnDefinitions="Auto, *" ColumnSpacing="18" VerticalOptions="Center" IsVisible="False" Opacity="0">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="{DynamicResource WarningGlassBackgroundColor}" WidthRequest="54" HeightRequest="54" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Path Data="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z" Fill="#F59E0B" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Border HorizontalOptions="Start" StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource WarningGlassBackgroundColor}" Padding="8,3" Margin="0,0,0,2">
                                            <Label Text="3D SIGN DICTIONARY" TextColor="#F59E0B" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <Label Text="1,000+ ASL Sign Library" TextColor="{DynamicResource PrimaryTextColor}" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="Search signs with 3D avatars, slow-motion playback, and video demos." TextColor="{DynamicResource SecondaryTextColor}" FontSize="13" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>

                            </Grid>

                            <!-- Glass Indicator Dots -->
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,2,0,0">
                                <Border x:Name="Dot1" WidthRequest="24" HeightRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource PrimaryColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDot1Tapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border x:Name="Dot2" WidthRequest="8" HeightRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource SecondaryTextColor}" Opacity="0.4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDot2Tapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border x:Name="Dot3" WidthRequest="8" HeightRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource SecondaryTextColor}" Opacity="0.4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDot3Tapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Original Bottom Subtitle -->
                    <Label Text="Over 10,000 students learning ASL with us." 
                           TextColor="{DynamicResource SecondaryTextColor}" 
                           FontSize="14" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center" 
                           MaxLines="1" 
                           LineBreakMode="TailTruncation" />

                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
