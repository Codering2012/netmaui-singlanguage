<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SignLanguageApp.ViewModels"
             xmlns:controls="clr-namespace:SignLanguageApp.Controls"
             x:Class="SignLanguageApp.Pages.MistakeReplayPage"
             x:DataType="viewmodels:MistakeReplayViewModel"
             Title="Mistake Analysis"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <controls:MainLayout>
        <Grid RowDefinitions="Auto, *, Auto" Margin="0,10,0,0">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20, 24, 20, 16">
                <Button Text="←" 
                        FontSize="24" 
                        TextColor="{DynamicResource PrimaryTextColor}" 
                        BackgroundColor="Transparent"
                        Command="{Binding BackToLessonCommand}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0,0,0">
                    <Label Text="Mistake Analysis &amp; Comparison" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}"/>
                    <Label Text="Compare your hand posture with the standard sign demonstration" FontSize="14" TextColor="{DynamicResource SecondaryTextColor}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Main Comparison Area -->
            <ScrollView Grid.Row="1" Padding="20, 10, 20, 20">
                <VerticalStackLayout Spacing="20">
                    <!-- Advice Banner -->
                    <Border StrokeShape="RoundRectangle 20"
                            BackgroundColor="{DynamicResource WarningGlassBackgroundColor}"
                            Stroke="{DynamicResource WarningGlassStrokeColor}"
                            StrokeThickness="1"
                            Padding="20">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Text="🔍" FontSize="32" VerticalOptions="Center" Margin="0,0,16,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Hand Posture Adjustment Tip" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}"/>
                                <Label Text="Check thumb placement and finger extension. Make sure your hand is centered directly in front of your camera." 
                                       FontSize="14" 
                                       TextColor="{DynamicResource SecondaryTextColor}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Side-by-Side Comparison -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                        <!-- Standard Reference -->
                        <VerticalStackLayout Grid.Column="0" Spacing="10">
                            <Border BackgroundColor="{DynamicResource SuccessGlassBackgroundColor}" 
                                    Stroke="{DynamicResource SuccessGlassStrokeColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" 
                                    Padding="12,6" 
                                    HorizontalOptions="Center">
                                <Label Text="✓ Standard Sign" FontSize="13" FontAttributes="Bold" TextColor="#10B981"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 24"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1"
                                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                                    HeightRequest="280"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="{DynamicResource GlassShadowOpacity}"/>
                                </Border.Shadow>
                                <Grid VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="{Binding TargetGesture}" 
                                           FontSize="100" 
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           TextColor="{DynamicResource PrimaryColor}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- User Capture Frame -->
                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Border BackgroundColor="{DynamicResource ErrorGlassBackgroundColor}" 
                                    Stroke="{DynamicResource ErrorGlassStrokeColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" 
                                    Padding="12,6" 
                                    HorizontalOptions="Center">
                                <Label Text="📷 Your Capture" FontSize="13" FontAttributes="Bold" TextColor="#EF4444"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 24"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1"
                                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                                    HeightRequest="280"
                                    Padding="4">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="{DynamicResource GlassShadowOpacity}"/>
                                </Border.Shadow>
                                <Image Source="{Binding UserFrame, Converter={StaticResource BytesToImageConverter}}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="272"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Border StrokeShape="RoundRectangle 20"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1"
                            Padding="20">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="{DynamicResource GlassShadowOpacity}"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Target Gesture Code:" FontSize="14" TextColor="{DynamicResource SecondaryTextColor}"/>
                            <Label Text="{Binding TargetGesture, StringFormat='Sign Target: {0}'}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Footer Try Again -->
            <Border Grid.Row="2" Padding="20, 16" BackgroundColor="{DynamicResource CardBackgroundColor}" StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-4" Radius="15" Opacity="{DynamicResource GlassShadowOpacity}"/>
                </Border.Shadow>
                <Button Text="RETRY PRACTICE SIGN ➔" 
                        Command="{Binding BackToLessonCommand}"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        TextColor="{DynamicResource ButtonTextColor}"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="60"
                        FontSize="18" />
            </Border>
        </Grid>
    </controls:MainLayout>
</ContentPage>
