<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SignLanguageApp.Controls"
             x:Class="SignLanguageApp.Pages.TimeAttackPage"
             Title="Time Attack"
             BackgroundColor="Transparent">
    <controls:MainLayout>
        <Grid RowDefinitions="Auto,*,Auto" Padding="20,40,20,20">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Time Attack" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                    <Label Text="Score: 1200" FontSize="18" TextColor="{DynamicResource PrimaryColor}" FontAttributes="Bold" />
                </VerticalStackLayout>
                
                <Border Grid.Column="1" StrokeShape="RoundRectangle 50" BackgroundColor="{DynamicResource ErrorGlassBackgroundColor}" StrokeThickness="2" Stroke="{DynamicResource ErrorGlassStrokeColor}" HeightRequest="60" WidthRequest="60">
                    <Label Text="45s" TextColor="{DynamicResource ErrorColor}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="0,30" StrokeShape="RoundRectangle 24" BackgroundColor="{DynamicResource CardBackgroundColor}" StrokeThickness="1" Stroke="{DynamicResource BorderBrush}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="15" Opacity="{DynamicResource GlassShadowOpacity}"/>
                </Border.Shadow>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                    <Label Text="Sign this word:" TextColor="{DynamicResource SecondaryTextColor}" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="ELEPHANT" TextColor="{DynamicResource PrimaryTextColor}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Image Source="placeholder_video.png" HeightRequest="150" WidthRequest="200" Opacity="0.5" />
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
                <Button Grid.Column="0" Text="Skip" BackgroundColor="{DynamicResource SecondaryBackgroundColor}" TextColor="{DynamicResource PrimaryTextColor}" CornerRadius="16" HeightRequest="60" FontAttributes="Bold" FontSize="18" />
                <Button Grid.Column="1" Text="Camera Ready" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource ButtonTextColor}" CornerRadius="16" HeightRequest="60" FontAttributes="Bold" FontSize="18" />
            </Grid>
        </Grid>
    </controls:MainLayout>
</ContentPage>
