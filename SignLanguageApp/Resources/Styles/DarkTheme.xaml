<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SignLanguageApp.Resources.Styles.DarkTheme">

    <Color x:Key="PageBackgroundColor">#0F172A</Color>
    <Color x:Key="CardBackgroundColor">#B31E293B</Color>
    <Color x:Key="PrimaryTextColor">#F8FAFC</Color>
    <Color x:Key="SecondaryTextColor">#94A3B8</Color>
    
    <Color x:Key="PrimaryColor">#38BDF8</Color>
    <Color x:Key="SecondaryColor">#7DD3FC</Color>
    <Color x:Key="AccentColor">#FBBF24</Color>
    
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="CameraOverlayColor">#38BDF8</Color>
    <Color x:Key="ButtonBackgroundColor">#38BDF8</Color>
    <Color x:Key="ButtonTextColor">#0F172A</Color>
    
    <Color x:Key="InputBackgroundColor">#1E293B</Color>
    <Color x:Key="InputPlaceholderColor">#64748B</Color>
    
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>

    <Color x:Key="SecondaryBackgroundColor">#0B1325</Color>

    <Color x:Key="NavigationBarBackgroundColor">#0B1325</Color>
    <Color x:Key="NavigationBarTextColor">#F8FAFC</Color>

    <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F172A" Offset="0.0" />
        <GradientStop Color="#020617" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryThemeBrush" Color="{StaticResource PrimaryColor}" />

    <!-- Navigation Bar Glassmorphism Colors (Dark - Figma Liquid Glass Gradient Rim) -->
    <Color x:Key="NavBarRimColor">#80334155</Color>
    <Color x:Key="NavBarCenterColor">#200F172A</Color>
    <Color x:Key="NavBarBackgroundColor">#800F172A</Color>
    <Color x:Key="NavBarStrokeColor">#40475569</Color>
    <Color x:Key="NavBarGlassHighlight">#50FFFFFF</Color>
    <Color x:Key="NavBarIconTintColor">#FFFFFF</Color>
    <Color x:Key="NavBarInactiveColor">#94A3B8</Color>
    <Color x:Key="NavBarActiveColor">#38BDF8</Color>
    <Color x:Key="NavBarActivePillColor">#3538BDF8</Color>
    <Color x:Key="NavBarActivePillStroke">#8038BDF8</Color>
    <x:Single x:Key="GlassShadowOpacity">0.35</x:Single>
    <x:Double x:Key="AmbientBlobOpacity">0.55</x:Double>

    <!-- Gamification Glass Colors (Dark) -->
    <Color x:Key="SuccessGlassBackgroundColor">#2010B981</Color>
    <Color x:Key="SuccessGlassStrokeColor">#3310B981</Color>
    <Color x:Key="SuccessGlassSolidColor">#E610B981</Color>

    <Color x:Key="WarningGlassBackgroundColor">#20F59E0B</Color>
    <Color x:Key="WarningGlassStrokeColor">#33F59E0B</Color>

    <Color x:Key="ErrorGlassBackgroundColor">#20EF4444</Color>
    <Color x:Key="ErrorGlassStrokeColor">#33EF4444</Color>
    <Color x:Key="ErrorGlassSolidColor">#E6EF4444</Color>

    <Color x:Key="PrimaryGlassBackgroundColor">#203B82F6</Color>
    <Color x:Key="PrimaryGlassStrokeColor">#333B82F6</Color>
    
    <Color x:Key="CameraOverlayBackgroundColor">#B3000000</Color>

</ResourceDictionary>
